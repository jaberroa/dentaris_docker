<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         processIsolation="false"
         stopOnFailure="false">
    <testsuites>
        <testsuite name="PatientUnit">
            <file>tests/Unit/PatientTest.php</file>
        </testsuite>
        <testsuite name="PatientFeature">
            <file>tests/Feature/PatientTest.php</file>
        </testsuite>
        <testsuite name="PatientApi">
            <file>tests/Feature/PatientApiTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">./app/Models/Patient.php</directory>
            <directory suffix=".php">./app/Http/Controllers/PatientController.php</directory>
            <directory suffix=".php">./app/Http/Controllers/Api/PatientApiController.php</directory>
            <directory suffix=".php">./app/Http/Requests/PatientRequest.php</directory>
            <directory suffix=".php">./app/Http/Resources/PatientResource.php</directory>
            <directory suffix=".php">./app/Exports/PatientsExport.php</directory>
        </include>
    </source>
    <coverage>
        <include>
            <directory suffix=".php">./app/Models/Patient.php</directory>
            <directory suffix=".php">./app/Http/Controllers/PatientController.php</directory>
            <directory suffix=".php">./app/Http/Controllers/Api/PatientApiController.php</directory>
            <directory suffix=".php">./app/Http/Requests/PatientRequest.php</directory>
            <directory suffix=".php">./app/Http/Resources/PatientResource.php</directory>
            <directory suffix=".php">./app/Exports/PatientsExport.php</directory>
        </include>
        <report>
            <html outputDirectory="coverage/patients"/>
            <text outputFile="coverage/patients/coverage.txt"/>
            <clover outputFile="coverage/patients/coverage.xml"/>
        </report>
    </coverage>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
