                        @php
                            // Definir dientes según tipo de paciente
                            $patientType = $plan->patient_type ?? 'adult';
                            
                            if ($patientType === 'child') {
                                // Dientes temporales (20 dientes) - Sistema FDI
                                $upperRight = ['55','54','53','52','51'];  // Cuadrante 5 (Superior derecho del paciente)
                                $upperLeft = ['61','62','63','64','65'];   // Cuadrante 6 (Superior izquierdo del paciente)
                                $lowerRight = ['85','84','83','82','81'];  // Cuadrante 8 (Inferior derecho del paciente)
                                $lowerLeft = ['71','72','73','74','75'];   // Cuadrante 7 (Inferior izquierdo del paciente)
                            } elseif ($patientType === 'mixed') {
                                // Dientes mixtos (temporales + permanentes) - Sistema FDI
                                $upperRight = ['18','17','16','15','14','13','12','11','55','54','53','52','51'];
                                $upperLeft = ['61','62','63','64','65','21','22','23','24','25','26','27','28'];
                                $lowerRight = ['85','84','83','82','81','48','47','46','45','44','43','42','41'];
                                $lowerLeft = ['71','72','73','74','75','31','32','33','34','35','36','37','38'];
                            } else {
                                // Dientes permanentes adultos (32 dientes) - Sistema FDI
                                // Vista del odontólogo mirando al paciente de frente
                                $upperRight = ['18','17','16','15','14','13','12','11']; // Cuadrante 1 (Superior derecho del paciente)
                                $upperLeft = ['21','22','23','24','25','26','27','28'];   // Cuadrante 2 (Superior izquierdo del paciente)
                                $lowerRight = ['48','47','46','45','44','43','42','41']; // Cuadrante 4 (Inferior derecho del paciente)
                                $lowerLeft = ['31','32','33','34','35','36','37','38'];   // Cuadrante 3 (Inferior izquierdo del paciente)
                            }
                        @endphp

