                    <div class="mb-3">
                        <label for="prioritySlide" class="form-label">Prioridad</label>
                        <select class="form-select" id="prioritySlide">
                            <option value="">Seleccionar prioridad...</option>
                            <option value="low">Baja</option>
                            <option value="medium">Media</option>
                            <option value="high">Alta</option>
                            <option value="urgent">Urgente</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="generalNotesSlide" class="form-label">Observaciones Generales</label>
                        <textarea class="form-control" id="generalNotesSlide" rows="3" placeholder="Notas adicionales sobre la condición del diente..."></textarea>
                    </div>
                </div>

                <!-- Pestaña 2: Superficies -->
                <div class="tab-pane fade" id="surfaces-slide" role="tabpanel">
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label">Oclusal (O)</label>
                            <select class="form-select surface-condition" data-surface="occlusal" id="surface-occlusal-slide">
                                <option value="">Sin condición</option>
                                <option value="caries">Caries</option>
                                <option value="filling">Obturación</option>
                                <option value="crown">Corona</option>
                            </select>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">Mesial (M)</label>
                            <select class="form-select surface-condition" data-surface="mesial" id="surface-mesial-slide">
                                <option value="">Sin condición</option>
                                <option value="caries">Caries</option>
                                <option value="filling">Obturación</option>
                                <option value="crown">Corona</option>
                            </select>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">Distal (D)</label>
                            <select class="form-select surface-condition" data-surface="distal" id="surface-distal-slide">
                                <option value="">Sin condición</option>
                                <option value="caries">Caries</option>
                                <option value="filling">Obturación</option>
                                <option value="crown">Corona</option>
                            </select>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">Vestibular (V)</label>
                            <select class="form-select surface-condition" data-surface="vestibular" id="surface-vestibular-slide">
                                <option value="">Sin condición</option>
                                <option value="caries">Caries</option>
                                <option value="filling">Obturación</option>
                                <option value="crown">Corona</option>
                            </select>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">Lingual (L)</label>
                            <select class="form-select surface-condition" data-surface="lingual" id="surface-lingual-slide">
                                <option value="">Sin condición</option>
                                <option value="caries">Caries</option>
                                <option value="filling">Obturación</option>
                                <option value="crown">Corona</option>
                            </select>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">Incisal (I)</label>
                            <select class="form-select surface-condition" data-surface="incisal" id="surface-incisal-slide">
                                <option value="">Sin condición</option>
                                <option value="caries">Caries</option>
                                <option value="filling">Obturación</option>
                                <option value="crown">Corona</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Pestaña 3: Tratamiento -->
                <div class="tab-pane fade" id="treatment-slide" role="tabpanel">
                    <div class="mb-3">
                        <label for="procedure_nameSlide" class="form-label">Nombre del Procedimiento</label>
                        <input type="text" class="form-control" id="procedure_nameSlide" placeholder="Ej: Obturación de amalgama">
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label for="cdt_codeSlide" class="form-label">Código CDT</label>
                            <input type="text" class="form-control" id="cdt_codeSlide" placeholder="Ej: D2140">
                        </div>
                        <div class="col-6 mb-3">
                            <label for="estimated_timeSlide" class="form-label">Tiempo Estimado (min)</label>
                            <input type="number" class="form-control" id="estimated_timeSlide" placeholder="30">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label for="estimated_costSlide" class="form-label">Costo Estimado</label>
                            <input type="number" class="form-control" id="estimated_costSlide" placeholder="150.00" step="0.01">
                        </div>
                        <div class="col-6 mb-3">
                            <label for="scheduled_dateSlide" class="form-label">Fecha Programada</label>
                            <input type="date" class="form-control" id="scheduled_dateSlide">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="treatment_notesSlide" class="form-label">Notas del Tratamiento</label>
                        <textarea class="form-control" id="treatment_notesSlide" rows="3" placeholder="Detalles del procedimiento..."></textarea>
                    </div>
                </div>

                <!-- Pestaña 4: Avanzado -->
                <div class="tab-pane fade" id="advanced-slide" role="tabpanel">
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label for="mobilitySlide" class="form-label">Movilidad</label>
                            <select class="form-select" id="mobilitySlide">
                                <option value="">Sin movilidad</option>
                                <option value="1">Grado 1</option>
                                <option value="2">Grado 2</option>
                                <option value="3">Grado 3</option>
                            </select>
                        </div>
                        <div class="col-6 mb-3">
                            <label for="pocket_depthSlide" class="form-label">Profundidad de Sondaje</label>
                            <input type="text" class="form-control" id="pocket_depthSlide" placeholder="Ej: 2-3mm">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="bleedingSlide">
                                <label class="form-check-label" for="bleedingSlide">Sangrado al sondaje</label>
                            </div>
                        </div>
                        <div class="col-6 mb-3">
                            <label for="recessionSlide" class="form-label">Recesión Gingival (mm)</label>
                            <input type="number" class="form-control" id="recessionSlide" step="0.1">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="radiolucencySlide">
                                <label class="form-check-label" for="radiolucencySlide">Radiolucidez</label>
                            </div>
                        </div>
                        <div class="col-6 mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="bone_lossSlide">
                                <label class="form-check-label" for="bone_lossSlide">Pérdida ósea</label>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="periapical_lesionSlide">
                            <label class="form-check-label" for="periapical_lesionSlide">Lesión periapical</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="advanced_notesSlide" class="form-label">Notas Avanzadas</label>
                        <textarea class="form-control" id="advanced_notesSlide" rows="3" placeholder="Observaciones adicionales..."></textarea>
                    </div>
                </div>

                <!-- Pestaña 5: Archivos -->
                <div class="tab-pane fade" id="files-slide" role="tabpanel">
                    <div class="mb-3">
                        <label class="form-label">Subir Archivos</label>
                        <div class="border border-2 border-dashed rounded p-4 text-center" id="dropZoneSlide">
                            <i class="fas fa-cloud-upload-alt fa-3x text-muted mb-3"></i>
                            <p class="mb-2">Arrastra archivos aquí o haz clic para seleccionar</p>
                            <button type="button" class="btn btn-outline-primary" id="selectFilesBtnSlide">
                                <i class="fas fa-folder-open me-1"></i>Seleccionar Archivos
                            </button>
                            <input type="file" class="d-none" id="fileInputSlide" multiple accept="image/*,.pdf,.doc,.docx">
                        </div>
                    </div>
                    <div id="selectedFilesContainerSlide" class="mb-3"></div>
                    <div id="existingFilesContainerSlide" class="mb-3"></div>
                </div>
            </div>
        </div>
        <div class="offcanvas-footer bg-light border-top p-3">
            <div class="d-flex justify-content-between">
                <button type="button" class="btn btn-danger" id="deleteToothEvaluationSlide">
                    <i class="fas fa-trash-alt me-1"></i>Borrar Condiciones
                </button>
                <div>
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="offcanvas">
                        <i class="fas fa-times me-1"></i>Cancelar
                    </button>
                    <button type="button" class="btn btn-primary" id="saveDentalEvaluationSlide">
                        <i class="fas fa-save me-1"></i>Guardar Evaluación
                    </button>
                </div>
            </div>
        </div>
    </div>
@endsection

@section('css')
<style>
/* Odontograma Interactivo Avanzado */
.odontogram-container {
    /* background: #f8f9fa; */
    border-radius: 1rem;
    padding: 3rem;
    border: 2px solid #e9ecef;
    overflow-x: auto;
    min-width: 100%;
}

.jaw-section {
    position: relative;
}

.jaw-label {
    font-size: 0.75rem;
    letter-spacing: 0.5px;
    color: #6c757d;
}

.teeth-row {
    align-items: center;
}

.quadrant {
    align-items: center;
}

.midline {
    width: 2px;
    height: 60px;
    background: linear-gradient(to bottom, #dee2e6, #adb5bd);
    margin: 0 1rem;
    border-radius: 1px;
}

.gum-line {
    display: flex;
    justify-content: center;
}

.gum-line .line {
    width: 80%;
    height: 2px;
    background: linear-gradient(to right, #dee2e6, #adb5bd, #dee2e6);
    border-radius: 1px;
}

/* Contenedor de Diente */
.tooth-container {
    position: relative;
    margin: 0;
}

.interactive-tooth {
    position: relative;
    width: 45px;
    height: 55px;
    /* background: #ffffff; */
    /* border: 2px solid #dee2e6; */
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

/* SVG de fondo por diente específico (raíz) */
.interactive-tooth[data-tooth="18"]::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url('/images/teeth/adult/18C.svg');
    background-size: 100% 100%;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.6;
    z-index: 1;
    pointer-events: none;
}

/* SVG superior del diente (corona/parte superior) */
.tooth-container[data-tooth="18"]::before {
    content: '';
    position: absolute;
    top: -60px;
    left: 50%;
    transform: translateX(-50%);
    width: 45px;
    height: 60px;
    background-image: url('/images/teeth/adult/18D.svg');
    background-size: contain;
    background-position: center bottom;
    background-repeat: no-repeat;
    opacity: 0.6;
    z-index: 1;
    pointer-events: none;
    filter: none;
    transition: filter 0.3s ease;
}

/* Sombra verde para 18u cuando el diente tiene condición */
.tooth-container[data-tooth="18"].has-condition::before {
    filter: drop-shadow(0 4px 8px rgba(56, 198, 108, 0.5));
}

/* SVG de fondo para diente 17 (raíz) */
