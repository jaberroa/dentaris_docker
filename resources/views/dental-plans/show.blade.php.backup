                            });
                        }
                    }
                    
                    // Aplicar condiciones de superficies
                    if (toothData.surfaces) {
                        Object.entries(toothData.surfaces).forEach(([surface, condition]) => {
                            applySurfaceCondition(toothData.toothNumber, surface, condition);
                        });
                    }
                    
                    console.log(`✅ Diente ${toothData.toothNumber} cargado`);
                })();
            @endforeach
            
            console.log('✅ Odontograma cargado completamente');
        }, 500);
    @else
        console.log('ℹ️ No hay datos guardados del odontograma');
    @endif
}

// Función para mostrar toasts
function showToast(message, type = 'success') {
    const toastContainer = document.querySelector('.toast-container') || createToastContainer();
    
    const toastId = 'toast-' + Date.now();
    const isSuccess = type === 'success';
    const bgColor = isSuccess ? '#38c66c' : '#dc3545';
    const icon = isSuccess ? 'fa-check' : 'fa-exclamation-triangle';
    const title = isSuccess ? '¡Éxito!' : 'Error';
    const bodyIcon = isSuccess ? 'fa-tooth' : 'fa-exclamation-circle';
    
    const toastHTML = `
        <div id="${toastId}" class="toast" role="alert" aria-live="assertive" aria-atomic="true" style="transition: opacity 0.5s ease-out;">
            <div class="toast-header text-white border-0" style="background: ${bgColor} !important; background-color: ${bgColor} !important; background-image: none !important;">
                <div class="avatar avatar-xs avatar-label-light me-2">
                    <i class="fas ${icon} fs-12"></i>
                </div>
                <strong class="me-auto">${title}</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body bg-light">
                <div class="d-flex align-items-center">
                    <div class="avatar avatar-xs avatar-label-${isSuccess ? 'success' : 'danger'} me-2">
                        <i class="fas ${bodyIcon} fs-12"></i>
                    </div>
                    <span class="text-muted">${message}</span>
                </div>
            </div>
        </div>
    `;
    
    toastContainer.insertAdjacentHTML('beforeend', toastHTML);
    const toastElement = document.getElementById(toastId);
    
    // Mostrar el toast con animación
    setTimeout(() => {
        toastElement.classList.add('show');
    }, 10);
    
    // Auto-ocultar después de 3 segundos con fade-out
    setTimeout(() => {
        if (toastElement) {
            // Fade out durante 0.5 segundos
            toastElement.style.opacity = '0';
            
            // Remover completamente después del fade-out
            setTimeout(() => {
                toastElement.classList.remove('show');
                setTimeout(() => toastElement.remove(), 150);
            }, 500);
        }
    }, 3000);
}

function createToastContainer() {
    const container = document.createElement('div');
    container.className = 'toast-container position-fixed top-0 end-0 p-3';
    container.style.zIndex = '9999';
    document.body.appendChild(container);
    return container;
}

// Script para el toast de éxito del sistema (cuando viene de edit/update)
document.addEventListener('DOMContentLoaded', function() {
    const successToast = document.getElementById('successToast');
    if (successToast) {
        const toast = new bootstrap.Toast(successToast, {
            autohide: false,
            delay: 0
        });
        toast.show();
        
        // Aplicar transición de desvanecimiento después de 3 segundos
        setTimeout(function() {
            successToast.style.opacity = '0';
            successToast.style.transform = 'scale(0.9)';
            successToast.style.transition = 'all 0.5s ease-out';
            
            // Remover el elemento después de la animación
            setTimeout(function() {
                successToast.remove();
            }, 500);
        }, 3000);
    }
});
</script>
@endsection
